{
  "name": "wakhan-standalone",
  "version": "0.2.13-beta",
  "description": "Wakhan independent iOS and Android client",
  "main": "index.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prepare:web": "node scripts/apply-ui-hotfix.cjs public/wakhan-shell.json && node scripts/validate-client.mjs",
    "build": "node scripts/build.mjs",
    "build:debug": "node scripts/build.mjs --debug",
    "sync": "cap sync android",
    "test": "node --test tests/*.test.mjs tests/*.test.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "vite": "8.3.6",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/ios": "8.6.0"
  },
  "private": true,
  "wakhanBuild": 26
}
