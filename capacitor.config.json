{
  "appId": "app.wakhan.music",
  "appName": "Wakhan",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#0047FF"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "disable"
    },
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#0047FF",
      "showSpinner": false
    },
    "Keyboard": {
      "resizeOnFullScreen": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#071019"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  },
  "loggingBehavior": "none"
}
